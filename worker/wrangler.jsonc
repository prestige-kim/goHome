{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gohome-transit-proxy",
  "main": "src/index.js",
  "compatibility_date": "2026-08-19",
  "workers_dev": true,
  "preview_urls": false,
  "secrets": {
