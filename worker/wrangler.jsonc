{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gohome-transit-proxy",
  "main": "src/index.js",
  "compatibility_date": "2026-08-19",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "ratelimits": [
    {
      "name": "HEALTH_RATE_LIMITER",
      "namespace_id": "320001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "REALTIME_RATE_LIMITER",
      "namespace_id": "320002",
      "simple": {
        "limit": 12,
        "period": 60
      }
    },
    {
      "name": "TIMETABLE_RATE_LIMITER",
      "namespace_id": "320003",
      "simple": {
        "limit": 16,
        "period": 60
      }
    }
  ],
  "secrets": {
    "required": [
      "SEOUL_API_KEY",
      "PUBLIC_DATA_API_KEY",
      "GOHOME_CLIENT_TOKEN"
    ]
  }
}
